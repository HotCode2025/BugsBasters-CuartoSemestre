# =============================================================================
# BOTANIKA & CO. - BACKEND CONFIGURACIÓN DE ENTORNO (.env)
# =============================================================================

# Puerto local del servidor Node / Express
PORT=3000

# -----------------------------------------------------------------------------
# CREDENCIALES DE MERCADO PAGO
# Panel de Desarrolladores: https://www.mercadopago.com.ar/developers/panel/app
# -----------------------------------------------------------------------------

# Access Token Privado (Requerido en el Backend):
# - Para Pruebas (Sandbox): Usa el token que comienza con "TEST-..."
# - Para Producción Real: Usa el token que comienza con "APP_USR-..."
# NOTA: En modo Sandbox (TEST-...) DEBES usar tarjetas de prueba de Mercado Pago.
#       No ingreses tarjetas de crédito/débito reales con un token TEST-.
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Public Key de Mercado Pago (Opcional en Backend, Requerido si usas SDK en Frontend / Bricks / Wallet):
# - Para Pruebas: TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# - Para Producción: APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# URLS DE INTEGRACIÓN Y REDIRECCIÓN
# -----------------------------------------------------------------------------

# URL del Frontend (donde corre la aplicación web):
# Mercado Pago redirigirá al cliente a esta URL (back_urls) al finalizar o cancelar el pago.
# - Local (Live Server en VSCode): http://127.0.0.1:5500
# - Producción (Vercel): https://bugsbasters-cuartosemestre.vercel.app
CLIENT_URL=http://127.0.0.1:5500

# URL Pública del Backend (para Webhooks y Notificaciones IPN de Mercado Pago):
# Mercado Pago enviará notificaciones automáticas de aprobación o rechazo a esta URL.
# - En Local con túnel: Usa ngrok (ej: https://xxxx-xx-xx.ngrok-free.app)
# - En Producción: https://tu-backend.onrender.com (o la URL de tu backend en Vercel/Railway)
# IMPORTANTE: Si estás en localhost sin ngrok, puedes dejarlo vacío o comentado;
#             el checkout funcionará normalmente mediante redirección por back_urls.
BACKEND_URL=https://tu-backend.onrender.com
