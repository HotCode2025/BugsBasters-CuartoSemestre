package utn.estudiantes;

import java.util.List;
import java.util.NoSuchElementException;
import java.util.Scanner;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

import utn.estudiantes.modelo.Estudiantes2022;
import utn.estudiantes.servicio.EstudianteServicio;

@SpringBootApplication
public class EstudiantesApplication implements CommandLineRunner {

    @Autowired
    private EstudianteServicio estudianteServicio;

    private static final Logger logger =
            LoggerFactory.getLogger(EstudiantesApplication.class);

    private static final String nl = System.lineSeparator();

    public static void main(String[] args) {
        logger.info("Iniciando la aplicación...");
        SpringApplication.run(EstudiantesApplication.class, args);
        logger.info("¡Aplicación finalizada!");
    }

    @Override
    public void run(String... args) {
        logger.info(nl + "Ejecutando el método run de Spring..." + nl);

        try (Scanner consola = new Scanner(System.in)) {
            boolean salir = false;

            while (!salir) {
                mostrarMenu();
                salir = ejecutarOpciones(consola);
            }
        } catch (NoSuchElementException finDeEntrada) {
            logger.info("Se cerró la entrada de consola.");
        }
    }

    private void mostrarMenu() {
        logger.info("""
                
                ******* Sistema de Estudiantes *******
                1. Listar Estudiantes
                2. Buscar Estudiante
                3. Agregar Estudiante
                4. Modificar Estudiante
                5. Eliminar Estudiante
                6. Salir
                Elija una opción:""");
    }

    private boolean ejecutarOpciones(Scanner consola) {
        int opcion = leerEntero(consola);
        boolean salir = false;

        switch (opcion) {
            // Parte 1 -> listarEstudiantes
            case 1 -> {
                logger.info("Listado de estudiantes:");

                List<Estudiantes2022> estudiantes =
                        estudianteServicio.listarEstudiantes();

                if (estudiantes.isEmpty()) {
                    logger.info("Todavía no hay estudiantes registrados.");
                }

                estudiantes.forEach(estudiante -> logger.info("{}", estudiante));
            }

            // Parte 2 -> buscarEstudiantePorId y agregarEstudiante
            case 2 -> {
                logger.info("Ingrese el ID del estudiante que desea buscar:");
                int idEstudiante = leerEntero(consola);

                Estudiantes2022 estudiante =
                        estudianteServicio.buscarEstudiantePorId(idEstudiante);

                if (estudiante != null) {
                    logger.info("Estudiante encontrado: {}", estudiante);
                } else {
                    logger.info("Estudiante no encontrado con el ID: {}", idEstudiante);
                }
            }

            case 3 -> {
                logger.info("Agregar estudiante");

                var estudiante = new Estudiantes2022();
                cargarDatos(consola, estudiante);
                estudianteServicio.guardarEstudiante(estudiante);

                logger.info("Estudiante agregado: {}", estudiante);
            }

            // Parte 3 -> modificarEstudiante
            case 4 -> {
                logger.info("Modificar estudiante");
                logger.info("Ingrese el ID del estudiante que desea modificar:");
                int idEstudiante = leerEntero(consola);

                Estudiantes2022 estudiante =
                        estudianteServicio.buscarEstudiantePorId(idEstudiante);

                if (estudiante != null) {
                    cargarDatos(consola, estudiante);
                    estudianteServicio.guardarEstudiante(estudiante);
                    logger.info("Estudiante modificado: {}", estudiante);
                } else {
                    logger.info("Estudiante no encontrado con el ID: {}", idEstudiante);
                }
            }

            // Parte 4 -> eliminarEstudiante y salir
            case 5 -> {
                logger.info("Eliminar estudiante");
                logger.info("Ingrese el ID del estudiante que desea eliminar:");
                int idEstudiante = leerEntero(consola);

                Estudiantes2022 estudiante =
                        estudianteServicio.buscarEstudiantePorId(idEstudiante);

                if (estudiante != null) {
                    estudianteServicio.eliminarEstudiante(estudiante);
                    logger.info("Estudiante eliminado: {}", estudiante);
                } else {
                    logger.info("Estudiante no encontrado con el ID: {}", idEstudiante);
                }
            }

            case 6 -> {
                logger.info("¡Hasta pronto!");
                salir = true;
            }

            default -> logger.info("Opción no reconocida: {}", opcion);
        }

        return salir;
    }

    private void cargarDatos(Scanner consola, Estudiantes2022 estudiante) {
        logger.info("Nombre:");
        String nombre = consola.nextLine();

        logger.info("Apellido:");
        String apellido = consola.nextLine();

        logger.info("Teléfono:");
        String telefono = consola.nextLine();

        logger.info("Email:");
        String email = consola.nextLine();

        estudiante.setNombre(nombre);
        estudiante.setApellido(apellido);
        estudiante.setTelefono(telefono);
        estudiante.setEmail(email);
    }

    private int leerEntero(Scanner consola) {
        while (true) {
            String entrada = consola.nextLine().trim();

            try {
                return Integer.parseInt(entrada);
            } catch (NumberFormatException e) {
                logger.info("Ingresá un número entero y volvé a intentar:");
            }
        }
    }
}
